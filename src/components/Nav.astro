---
interface Props { active?: string }
const { active } = Astro.props;

const links = [
  { href: '/Kartik_Resume.pdf', label: 'Résumé' },
  { href: 'https://github.com/KartikJain14', label: 'GitHub' },
  { href: 'https://linkedin.com/in/kartikjain1410', label: 'LinkedIn' },
  { href: 'https://twitter.com/kartikjain1410', label: 'Twitter' },
  { href: 'mailto:contact@jkartik.in', label: 'Email' },
  { href: '/blog/', label: 'Blog', key: 'blog' },
  { href: '/projects/', label: 'Projects', key: 'projects' },
];
---
<nav>
  <div class="nav-inner">
    <a class="wordmark" href="/">Kartik Jain</a>
    <div class="nav-links">
      {links.map((l) => (
        <a href={l.href} class={l.key && active === l.key ? 'here' : undefined}>{l.label}</a>
      ))}
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle light and dark theme" title="Toggle theme">
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </div>
  </div>
</nav>
