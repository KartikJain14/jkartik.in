---
import Base from '../../layouts/Base.astro';
import { coverFor } from '../../lib/covers';
import { imageSize } from '../../lib/image-size';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE, WEBSITE_ID, PERSON_ID, personRef, breadcrumbs } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  newer: CollectionEntry<'blog'> | null;
  older: CollectionEntry<'blog'> | null;
}
const { post, newer, older } = Astro.props as Props;
const { Content, headings } = await render(post);
const sections = headings.filter((heading) => heading.depth === 2);

const d = post.data;
const cover = d.cover ?? coverFor(d.tag, 600);
const coverSize = imageSize(cover);
const dateH = d.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const dateISO = d.date.toISOString();
const words = (post.body ?? '').trim().split(/\s+/).length;
const mins = Math.max(1, Math.round(words / 200));

// OG image must be a real, fetchable URL — use a real cover file if the post has
// one, otherwise the brand image (never the inline SVG data-URI cover).
const ogImage = d.socialImage ?? d.cover ?? '/og/kartik-jain.jpg';
const postUrl = new URL(`/blog/${post.id}/`, Astro.site).href;
const imageUrl = new URL(ogImage, Astro.site).href;
const socialSize = imageSize(ogImage);
const modified = d.updated ?? d.date;
const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((candidate) => candidate.id !== post.id)
  .sort((first, second) => Number(second.data.tag === d.tag) - Number(first.data.tag === d.tag)
    || second.data.date.valueOf() - first.data.date.valueOf())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${postUrl}#post`,
      headline: d.title,
      description: d.description,
      datePublished: dateISO,
      dateModified: modified.toISOString(),
      url: postUrl,
      mainEntityOfPage: { '@id': `${postUrl}#webpage` },
      inLanguage: 'en',
      image: { '@type': 'ImageObject', url: imageUrl, ...(socialSize ?? {}) },
      wordCount: words,
      articleSection: d.tag,
      keywords: d.tag,
      author: personRef,
      publisher: personRef,
      isPartOf: { '@id': `${SITE}/blog/#blog` },
      isAccessibleForFree: true,
      timeRequired: `PT${mins}M`,
    },
    {
      '@type': 'WebPage',
      '@id': `${postUrl}#webpage`,
      url: postUrl,
      name: d.title,
      description: d.seoDescription ?? d.description,
      isPartOf: { '@id': WEBSITE_ID },
      mainEntity: { '@id': `${postUrl}#post` },
      about: { '@id': PERSON_ID },
      breadcrumb: { '@id': `${postUrl}#breadcrumb` },
    },
    { ...breadcrumbs([['Home', '/'], ['Writing', '/blog/'], [d.title, `/blog/${post.id}/`]]), '@id': `${postUrl}#breadcrumb` },
  ],
};
---
<Base title={`${d.title} — Kartik Jain`} description={d.seoDescription ?? d.description} ogType="article" image={ogImage} published={d.date} modified={modified} active="blog" progress={true}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main>
  <article>
    <div class="post-head">
      <a class="crumb hero-in" href="/blog/">← Writing</a>
      <p class="eyebrow hero-in" style="--d:.05s">{d.tag}</p>
      <h1 class="title hero-in" style="--d:.1s">{d.title}</h1>
      <div class="byline hero-in" style="--d:.15s">
        <a class="who" href="/" rel="author" style="text-decoration:none">Kartik Jain</a>
        <time datetime={dateISO}>{dateH}</time>
        {d.updated && <span>Updated <time datetime={d.updated.toISOString()}>{d.updated.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}</time></span>}
        <span>{mins} min read</span>
      </div>
    </div>

    <img class="cover-hero hero-in" style="--d:.2s" alt="" src={cover} width={coverSize?.width} height={coverSize?.height} />

    <div class="prose">
      {sections.length > 2 && <nav aria-label="In this article" class="article-contents">
        <details>
          <summary>In this article</summary>
          <ol>{sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
        </details>
      </nav>}
      <Content />
      <aside aria-label="Related writing">
        <h2>Related writing</h2>
        <ul>{related.map((candidate) => <li><a href={`/blog/${candidate.id}/`}>{candidate.data.title}</a></li>)}</ul>
      </aside>
      <p class="aside">Questions or corrections? <a href="mailto:contact@jkartik.in">Email Kartik</a>. Read <a href="/publishing/">about this site's authorship and publishing</a>.</p>
    </div>

    <div class="endcard reveal">
      <div class="txt">
        <p class="ec-title"><a href="/" rel="author" style="color:inherit;text-decoration:none">Kartik Jain</a></p>
        <p>Security engineer and backend developer in Mumbai. Available for web-app security testing, penetration testing, and backend/API builds.</p>
        <a class="cta" href="/hire/">Work with me →</a>
      </div>
    </div>

    <nav class="pager">
      {newer ? (
        <a class="prev" href={`/blog/${newer.id}/`}>
          <span class="plabel">← Newer</span>
          <span class="ptitle">{newer.data.title}</span>
        </a>
      ) : (
        <a class="prev" href="/blog/">
          <span class="plabel">← Index</span>
          <span class="ptitle">All posts</span>
        </a>
      )}
      {older ? (
        <a class="next" href={`/blog/${older.id}/`}>
          <span class="plabel">Older →</span>
          <span class="ptitle">{older.data.title}</span>
        </a>
      ) : (
        <a class="next" href="/blog/">
          <span class="plabel">Index →</span>
          <span class="ptitle">All posts</span>
        </a>
      )}
    </nav>
  </article>
  </main>
</Base>

<style>
  .article-contents {
    margin-block: 1.5rem 2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--bg-lift);
  }
  .article-contents summary { cursor: pointer; font-weight: 600; }
  .article-contents a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
