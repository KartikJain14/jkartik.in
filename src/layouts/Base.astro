---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_OG, NAME, website, personCompact } from '../lib/seo';
import { imageSize, imageType } from '../lib/image-size';

interface Props {
  title: string;
  description: string;
  ogType?: string;
  image?: string;
  imageAlt?: string;
  /** article pages: publish / last-modified dates for article:* meta */
  published?: Date;
  modified?: Date;
  noindex?: boolean;
  active?: string;
  progress?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  image = DEFAULT_OG.src,
  imageAlt,
  published,
  modified,
  noindex = false,
  active,
  progress = false,
} = Astro.props;

// homepage hides the nav until you scroll past the hero (it shows the same links);
// every other page shows the nav from the very top.
const isHome = Astro.url.pathname === '/';

// One URL per page: always the trailing-slash directory form (build.format = 'directory').
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/([^/])$/, '$1/');
const canonical = new URL(path, Astro.site).href;

// <title> stays ≤60 chars so results never truncate it mid-word, and keeps the name whenever it
// can: a long "Headline: subtitle — Kartik Jain" becomes "Headline — Kartik Jain". Social cards
// have room, so og:title keeps the full wording (as do the page's H1 and JSON-LD headline).
const SUFFIX = ` — ${NAME}`;
const bareTitle = title.endsWith(SUFFIX) ? title.slice(0, -SUFFIX.length) : title;
const shortTitle = () => {
  if (title.length <= 60) return title;
  const head = bareTitle.split(/[:–—]\s/)[0];
  if (head !== bareTitle && head.length + SUFFIX.length <= 60) return head + SUFFIX;
  if (bareTitle.length <= 60) return bareTitle;
  const cut = bareTitle.slice(0, 60);
  return cut.slice(0, cut.lastIndexOf(' '));
};
const docTitle = shortTitle();
const ogTitle = title.length <= 60 ? title : bareTitle;

// meta description: ≤155 chars, cut at a word boundary (cards keep the full text).
const clamp = (s: string, n = 155) => {
  const t = s.replace(/\s+/g, ' ').trim();
  if (t.length <= n) return t;
  const cut = t.slice(0, n - 1);
  return cut.slice(0, cut.lastIndexOf(' ')).replace(/[\s,;:—–-]+$/, '') + '…';
};
const metaDescription = clamp(description);

const imageUrl = new URL(image, Astro.site).href;
const isDefaultImage = image === DEFAULT_OG.src;
const dims = isDefaultImage ? DEFAULT_OG : imageSize(image);
const mime = imageType(image);
const alt = imageAlt ?? (isDefaultImage ? DEFAULT_OG.alt : `Cover image for “${ogTitle}”`);

// Sitewide graph: the WebSite + a compact Person, so every page's author/@id references
// resolve. The homepage emits the full Person itself (src/lib/seo.ts → personFull).
const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': isHome ? [website] : [website, personCompact],
};
---
<!DOCTYPE html>
<html lang="en" id="top">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{docTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="author" content="Kartik Jain" />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#14120f" media="(prefers-color-scheme: dark)" />

  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title="Kartik Jain — Writing" href="/rss.xml" />
  <link rel="alternate" type="text/plain" title="Kartik Jain — profile for AI assistants" href="/llms.txt" />
  <link rel="author" type="text/plain" href="/humans.txt" />
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/kartik.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="me" href="https://github.com/KartikJain14" />
  <link rel="me" href="https://www.linkedin.com/in/kartikjain1410/" />
  <link rel="me" href="https://x.com/kartikjain1410" />
  <link rel="me" href="mailto:contact@jkartik.in" />

  <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/instrument-serif-400-italic.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="dns-prefetch" href="https://cloud.umami.is" />

  <!-- Open Graph -->
  <meta property="og:site_name" content="Kartik Jain" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={imageUrl} />
  {mime && <meta property="og:image:type" content={mime} />}
  {dims && <meta property="og:image:width" content={String(dims.width)} />}
  {dims && <meta property="og:image:height" content={String(dims.height)} />}
  <meta property="og:image:alt" content={alt} />
  {ogType === 'profile' && <meta property="profile:first_name" content="Kartik" />}
  {ogType === 'profile' && <meta property="profile:last_name" content="Jain" />}
  {ogType === 'profile' && <meta property="profile:username" content="kartikjain1410" />}
  {ogType === 'article' && <meta property="article:author" content="https://jkartik.in/" />}
  {published && <meta property="article:published_time" content={published.toISOString()} />}
  {modified && <meta property="article:modified_time" content={modified.toISOString()} />}

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={alt} />
  <meta name="twitter:site" content="@kartikjain1410" />
  <meta name="twitter:creator" content="@kartikjain1410" />

  <script type="application/ld+json" set:html={JSON.stringify(siteGraph)} />

  <script is:inline>
    document.documentElement.classList.add('js');
    /* set the theme before paint — saved choice, else OS preference — so there's no flash */
    try {
      var _t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = _t;
    } catch (e) {}
  </script>

  <!-- If you're reading this: hi. Ship things, be kind, drink water. -->

  <slot name="head" />

  <!-- Umami analytics -->
  <script defer src="https://cloud.umami.is/script.js" data-website-id="2d866edd-cb4c-4a8e-90b2-f2152ce0a813"></script>
</head>
<body class={isHome ? undefined : 'has-topnav'}>
  <Nav active={active} />
  {progress && <div class="progress" id="progress"></div>}

  <slot />

  <Footer />

  <script is:inline>
    (function () {
      var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* a little something for anyone who opens the console */
      console.log('%c ~ Kartik Jain ', 'background:#e0a054;color:#14120f;font:700 13px monospace;padding:3px 8px;border-radius:4px');
      console.log('%cPoking around the source? Respect.\nFound a bug or a vuln?  → /.well-known/security.txt\nWant to build something? → contact@jkartik.in', 'color:#8b8375;font:12px/1.7 monospace');

      /* copy button on every code block (subtle, appears on hover) */
      var COPY_ICON = '<svg class="i-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
      var CHECK_ICON = '<svg class="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      document.querySelectorAll('.prose pre').forEach(function (pre) {
        var wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.parentNode.insertBefore(wrap, pre);
        wrap.appendChild(pre);
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'copy-btn';
        btn.setAttribute('aria-label', 'Copy code');
        btn.innerHTML = COPY_ICON + CHECK_ICON;
        wrap.appendChild(btn);
        btn.addEventListener('click', function () {
          navigator.clipboard.writeText(pre.innerText.replace(/\n$/, '')).then(function () {
            wrap.classList.add('copied');
            setTimeout(function () { wrap.classList.remove('copied'); }, 1400);
          });
        });
      });

      /* any link leaving jkartik.in opens in a new tab */
      document.querySelectorAll('a[href]').forEach(function (a) {
        var url;
        try { url = new URL(a.href, location.href); } catch (e) { return; }
        if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
        if (url.host === location.host || url.host === 'jkartik.in') return;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      });

      /* light/dark theme toggle */
      document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
        });
      });

      /* reveal the fixed navbar only after the hero — up top it just duplicates
         the hero's own links, so it stays hidden until you've scrolled past */
      var nav = document.querySelector('body > nav');
      if (nav) {
        if (document.body.classList.contains('has-topnav')) {
          // nav is shown from the top here — reserve matching space so it never overlaps content
          var pad = function () { document.body.style.paddingTop = nav.offsetHeight + 'px'; };
          pad();
          window.addEventListener('resize', pad);
          window.addEventListener('load', pad);
        } else {
          // homepage: reveal the nav only after you scroll past the hero (it duplicates the
          // hero's own links up top, so it stays hidden until then)
          var hero = document.querySelector('header.hero');
          var navThreshold = 300;
          var measureNav = function () { navThreshold = hero ? Math.max(hero.offsetHeight - 72, 120) : 300; };
          measureNav();
          var onNav = function () { nav.classList.toggle('show', window.scrollY > navThreshold); };
          document.addEventListener('scroll', onNav, { passive: true });
          window.addEventListener('resize', measureNav);
          onNav();
        }
      }

      /* reading progress bar (articles) */
      var bar = document.getElementById('progress');
      if (bar && !reduced) {
        var onScroll = function () {
          var h = document.documentElement;
          var max = h.scrollHeight - h.clientHeight;
          bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
        };
        document.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      /* one-time decode on the hero kicker */
      var kicker = document.getElementById('kicker');
      if (kicker && !reduced) {
        var out0 = kicker.textContent, glyphs = '!<>-_\\/[]{}=+*^?#', frame = 0, total = 24;
        var iv = setInterval(function () {
          frame++;
          var locked = Math.floor((frame / total) * out0.length), s = '';
          for (var i = 0; i < out0.length; i++) {
            var c = out0[i];
            s += (i < locked || c === ' ' || c === '·') ? c : glyphs[Math.floor(Math.random() * glyphs.length)];
          }
          kicker.textContent = s;
          if (frame >= total) { kicker.textContent = out0; clearInterval(iv); }
        }, 32);
      }

      /* scroll reveals */
      var els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });
        els.forEach(function (n) { io.observe(n); });
      } else {
        els.forEach(function (n) { n.classList.add('in'); });
      }
    })();
  </script>
</body>
</html>
